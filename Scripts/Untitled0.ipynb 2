      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# 1. Grid dependency curve: renewable electricity share vs. LCA carbon footprint per 1 kg H2\n",
        "ren_shares = np.linspace(0.0, 1.0, 21)\n",
        "lca_curve = []\n",
        "for r in ren_shares:\n",
        "    eff_ef_r = (1.0 - r) * grid_ef + r * ren_ef\n",
        "    tot_ghg_r = (grid_kwh_h * eff_ef_r) + (heat_mj_h * heat_ef)\n",
        "    lca_curve.append(tot_ghg_r / h2_kg_h)\n",
        "\n",
        "# 2. Scenario comparison: baseline vs. improved case (80% renewable + 40% heat recovery)\n",
        "eff_ef_opt = (1.0 - 0.80) * grid_ef + 0.80 * ren_ef\n",
        "net_heat_opt = heat_mj_h * (1.0 - 0.40)\n",
        "lca_opt = ((grid_kwh_h * eff_ef_opt) + (net_heat_opt * heat_ef)) / h2_kg_h\n",
        "\n",
        "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 4.5))\n",
        "\n",
        "# Left plot: grid share vs. utility LCA footprint\n",
        "ax1.plot(ren_shares * 100, lca_curve, marker='o', markersize=4)\n",
        "ax1.axhline(ghg_per_kg_h2, linestyle='--', label=f'Baseline ({ghg_per_kg_h2:.2f})')\n",
        "ax1.set_title('Grid Share vs. Utility LCA Footprint')\n",
        "ax1.set_xlabel('Renewable Electricity Share (%)')\n",
