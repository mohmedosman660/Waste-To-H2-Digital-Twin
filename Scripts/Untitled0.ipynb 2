      "source": [
        "import csv\n",
        "\n",
        "data = {}\n",
        "with open(\"inputs_baseline.csv\", mode=\"r\", encoding=\"utf-8-sig\") as f:\n",
        "    reader = csv.DictReader(f)\n",
        "    for row in reader:\n",
        "        data[row[\"parameter\"].strip()] = float(row[\"value\"])\n",
        "\n",
        "h2_kg_h = data[\"h2_output_kg_h\"]\n",
        "grid_kwh_h = data[\"grid_elec_kwh_h\"]\n",
        "ren_share = data[\"renewable_elec_share\"]\n",
        "grid_ef = data[\"grid_ef_kg_co2_per_kwh\"]\n",
        "ren_ef = data[\"ren_ef_kg_co2_per_kwh\"]\n",
        "heat_mj_h = data[\"heat_duty_mj_h\"]\n",
        "heat_ef = data[\"heat_ef_kg_co2_per_mj\"]\n",
        "elec_price = data[\"elec_price_usd_per_kwh\"]\n",
        "\n",
        "eff_elec_ef = (1.0 - ren_share) * grid_ef + ren_share * ren_ef\n",
        "elec_ghg_h = grid_kwh_h * eff_elec_ef\n",
        "heat_ghg_h = heat_mj_h * heat_ef\n",
        "total_ghg_h = elec_ghg_h + heat_ghg_h\n",
        "\n",
        "ghg_per_kg_h2 = total_ghg_h / h2_kg_h\n",
        "elec_cost_per_kg_h2 = (grid_kwh_h * elec_price) / h2_kg_h\n",
        "\n",
        "print(f\"H2 production: {h2_kg_h:.2f} kg/h\")\n",
        "print(f\"Effective electricity EF: {eff_elec_ef:.4f} kg CO2e/kWh\")\n",
        "print(f\"Total utility GHG: {total_ghg_h:.2f} kg CO2e/h\")\n",
        "print(f\"LCA (Utility Carbon Footprint): {ghg_per_kg_h2:.2f} kg CO2e / kg H2\")\n",
        "print(f\"TEA (Electricity Utility Cost): ${elec_cost_per_kg_h2:.2f} / kg H2\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import ipywidgets as widgets\n",
        "from IPython.display import display, clear_output\n",
        "\n",
        "# Interactive sliders for key process & energy scenarios\n",
        "ren_slider = widgets.FloatSlider(value=0.20, min=0.0, max=1.0, step=0.05, description='Renewable %:')\n",
        "heat_rec_slider = widgets.FloatSlider(value=0.0, min=0.0, max=0.60, step=0.05, description='Heat Recov %:')\n",
        "elec_use_slider = widgets.FloatSlider(value=50.0, min=20.0, max=200.0, step=10.0, description='Grid kWh/h:')\n",
        "\n",
        "out = widgets.Output()\n",
        "\n",
        "def update_twin(change=None):\n",
        "    with out:\n",
        "        clear_output(wait=True)\n",
        "        ren_share = ren_slider.value\n",
        "        heat_recovery = heat_rec_slider.value\n",
        "        elec_kwh_h = elec_use_slider.value\n",
        "\n",
        "        # Effective electricity emission factor\n",
        "        eff_ef = (1.0 - ren_share) * grid_ef + ren_share * ren_ef\n",
        "\n",
        "        # Net thermal duty after heat recovery\n",
        "        net_heat_mj_h = heat_mj_h * (1.0 - heat_recovery)\n",
        "\n",
        "        # Total GHG and LCA per kg H2\n",
        "        total_ghg = (elec_kwh_h * eff_ef) + (net_heat_mj_h * heat_ef)\n",
        "        lca_val = total_ghg / h2_kg_h\n",
        "\n",
        "        # Total utility OPEX (electricity + thermal fuel equivalent at $0.015/MJ)\n",
        "        util_cost_h = (elec_kwh_h * elec_price) + (net_heat_mj_h * 0.015)\n",
        "        tea_util_val = util_cost_h / h2_kg_h\n",
        "\n",
        "        print(\"=== CLIMATE DIGITAL TWIN: LIVE SCENARIO ===\")\n",
        "        print(f\"Renewable Electricity Share : {ren_share*100:.0f}%\")\n",
        "        print(f\"Heat Recovery Efficiency    : {heat_recovery*100:.0f}%\")\n",
        "        print(f\"Total Utility GHG           : {total_ghg:.2f} kg CO2e/h\")\n",
        "        print(f\"LCA Carbon Footprint        : {lca_val:.2f} kg CO2e / kg H2\")\n",
        "        print(f\"TEA Total Utility Cost      : ${tea_util_val:.2f} / kg H2\")\n",
        "\n",
        "ren_slider.observe(update_twin, names='value')\n",
        "heat_rec_slider.observe(update_twin, names='value')\n",
        "elec_use_slider.observe(update_twin, names='value')\n",
        "\n",
        "display(ren_slider, heat_rec_slider, elec_use_slider, out)\n",
        "update_twin()"
      ],
